rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir acceso total únicamente a los datos de cada usuario autenticado
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcolecciones: accounts, transactions, debts, goals, notes, recurrents
      match /{subcollection}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
